#!/usr/bin/env bash
set -euo pipefail

fail=0

for b in cargo cargo-audit git python3; do
    if ! command -v "$b" >/dev/null 2>&1; then
        echo "missing: $b" >&2
        fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    echo "==> bin/ci FAILED"
    exit 1
fi

# Build somewhere no other checkout of this package can reach.
#
# WHY: where cargo's `build.target-dir` points every checkout at one directory, two worktrees of
# this package write the same artifact paths and the fingerprints do not tell them apart. The gate
# then judges the units fresh from another branch's build and passes without compiling the current
# sources: new tests never appear in the output, and `CARGO_BIN_EXE_daytrace` starts a binary from
# another branch, so a whole-binary case exercises code that is not under test. That has already
# produced a green run for code that was never built, and a conclusion that the default branch was
# failing when it was not.
#
# WHY off the source disk rather than beside the crate: a target directory per worktree was
# deliberately configured away, because one project across many worktrees wrote tens of gigabytes
# of build artifacts to a DRAM-less SSD through btrfs and dm-crypt and stalled the desktop for
# seconds at a time. A build disk carries neither layer, so a per-worktree directory there keeps
# the gate honest without reintroducing what the shared directory exists to prevent.
#
# WHY not the temp directory, which is where this pointed until 2026-08-10: on a system where /tmp
# is a tmpfs, that put every build in RAM. The choice was measured as 268 MB for one worktree
# against a machine with tens of gigabytes free, and both halves of that premise expired together.
# Eight worktrees accumulated 3.7 GB, and holding it resident is part of why the machine no longer
# had the headroom. A tmpfs path grows with the number of checkouts, is never evicted, and
# is only reclaimed on reboot, so the cost is unbounded in exactly the dimension this repo's
# worktree convention scales.
#
# The fallback keeps the gate portable: the build disk is one machine's arrangement, and CI runners
# have no such mount. The path is derived from the checkout either way, so repeated runs in one
# worktree reuse their build, and an explicit CARGO_TARGET_DIR still wins for anyone who wants a
# different arrangement.
if [ -z "${CARGO_TARGET_DIR:-}" ]; then
    build_root=/mnt/build
    [ -d "$build_root" ] || build_root="${TMPDIR:-/tmp}"
    CARGO_TARGET_DIR="$build_root/cargo-target/$(basename "$PWD")"
    export CARGO_TARGET_DIR
fi
echo "==> building in $CARGO_TARGET_DIR"

echo "==> format check"
cargo fmt --check || fail=1

# --all-targets, because without it clippy checks only the library and binaries and never
# looks at a test target. Tests are where this project puts most of its reasoning, and the
# gate was silently exempting all of it: an unused import and a dead fixture constant both
# went green here while warning on every local `cargo test`.
echo "==> lint"
cargo clippy --all-targets -- -D warnings || fail=1

echo "==> test"
cargo test || fail=1

echo "==> dependency audit"
cargo audit || fail=1

echo "==> markdown wrap"
scripts/md-unwrap.py --check || fail=1

echo "==> prose guard"
bin/slop-guard || fail=1

if [ "$fail" -ne 0 ]; then
    echo "==> bin/ci FAILED"
    exit 1
fi

echo "CI green."

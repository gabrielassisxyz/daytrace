#!/usr/bin/env bash
set -euo pipefail

fail=0

for b in cargo cargo-audit git python3; do
    if ! command -v "$b" >/dev/null 2>&1; then
        echo "missing: $b" >&2
        fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    echo "==> bin/ci FAILED"
    exit 1
fi

# Build somewhere no other checkout of this package can reach.
#
# WHY: where cargo's `build.target-dir` points every checkout at one directory, two worktrees of
# this package write the same artifact paths and the fingerprints do not tell them apart. The gate
# then judges the units fresh from another branch's build and passes without compiling the current
# sources: new tests never appear in the output, and `CARGO_BIN_EXE_daytrace` starts a binary from
# another branch, so a whole-binary case exercises code that is not under test. That has already
# produced a green run for code that was never built, and a conclusion that the default branch was
# failing when it was not.
#
# WHY under /tmp rather than beside the crate: a target directory per worktree was deliberately
# configured away, because one project across many worktrees wrote tens of gigabytes of build
# artifacts to a DRAM-less SSD through btrfs and dm-crypt and stalled the desktop for seconds at a
# time. On tmpfs those writes never reach the disk, so the gate stops lying without reintroducing
# what the shared directory exists to prevent. Measured for this crate: 268 MB and a little over
# eight seconds from cold, against a machine with tens of gigabytes free.
#
# The path is derived from the checkout, so repeated runs in one worktree reuse their build, and
# an explicit CARGO_TARGET_DIR still wins for anyone who wants a different arrangement.
if [ -z "${CARGO_TARGET_DIR:-}" ]; then
    CARGO_TARGET_DIR="${TMPDIR:-/tmp}/cargo-target/$(basename "$PWD")"
    export CARGO_TARGET_DIR
fi
echo "==> building in $CARGO_TARGET_DIR"

echo "==> format check"
cargo fmt --check || fail=1

# --all-targets, because without it clippy checks only the library and binaries and never
# looks at a test target. Tests are where this project puts most of its reasoning, and the
# gate was silently exempting all of it: an unused import and a dead fixture constant both
# went green here while warning on every local `cargo test`.
echo "==> lint"
cargo clippy --all-targets -- -D warnings || fail=1

echo "==> test"
cargo test || fail=1

echo "==> dependency audit"
cargo audit || fail=1

echo "==> markdown wrap"
scripts/md-unwrap.py --check || fail=1

echo "==> prose guard"
bin/slop-guard || fail=1

if [ "$fail" -ne 0 ]; then
    echo "==> bin/ci FAILED"
    exit 1
fi

echo "CI green."
